# Docker-Entwicklungsumgebung — nicht für Produktion (Vorlage dafür: .env.production.example)
# Start: docker compose --profile db up

# Diese Datei geht an die Container (siehe docker-compose.yml)
APP_ENV_FILE=.env.docker

# Datenbank: "db" ist der mitgelieferte Container (Profil "db"). Für eine externe DB hier
# deren Host eintragen und ohne --profile db starten.
DB_HOST=db
DB_PORT=5432
DB_NAME=team_manager_db
DB_SCHEMA=team_manager
DB_USER=team_app
DB_PASS=team_app_dev

# Nur für den mitgelieferten DB-Container (Superuser, legt beim ersten Start Schema und
# den App-Benutzer DB_USER/DB_PASS an)
POSTGRES_DB=team_manager_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Admin credentials
# ADMIN_PASSWORD is used by docker/php/entrypoint.sh to generate ADMIN_PASSWORD_HASH at startup.
# Change ADMIN_PASSWORD to whatever you want — no manual hashing needed.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_PASSWORD_HASH=

APP_ENV=development
BASE_URL=localhost:8080

# E-Mail (development: 'mail' logs to error_log instead of sending)
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_FROM_NAME=Team Manager
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
