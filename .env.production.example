# Team Manager — Einstellungen für die Produktion. Kopieren nach .env.production (steht in
# .gitignore) und ausfüllen. Dieselbe Datei dient beiden Wegen:
#
#   Webspace (FTP):  ./deploy.sh lädt sie bei jedem Deployment als .env hoch; config.php liest sie.
#                    Änderungen hier kommen also mit dem nächsten Deployment an.
#   Docker:          docker compose --profile db --env-file .env.production up -d --build
#                    (ohne --profile db mit externer Datenbank)
#
# Format: KEY=Wert, Kommentare nur in eigenen Zeilen. Werte mit Leerzeichen oder # in "…" setzen.

# ── Datenbank ───────────────────────────────────────────────────────────────
# Webspace / externe DB: Host, Port, Name und Schema des Hosters. DB_SCHEMA genau so wie in der
# Datenbank — nie raten (README, „Datenbank-Änderungen“).
# Docker mit eigener DB (Profil "db"): DB_HOST=db, POSTGRES_* unten setzen.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=team_manager_db
DB_SCHEMA=team_manager
DB_USER=team_app
DB_PASS=

# ── Admin ───────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# Passwort als Hash. Erzeugen:  php -r 'echo password_hash("dein-passwort", PASSWORD_DEFAULT), PHP_EOL;'
ADMIN_PASSWORD_HASH=
# Nur Docker: Klartext-Passwort, wird beim Start gehasht. Für den Webspace leer lassen
# (deploy.sh bricht sonst ab — das Passwort läge im Klartext auf dem Server).
ADMIN_PASSWORD=

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=production
# Adresse der App ohne https:// (für Links in E-Mails, Kalender-Abos, Push), z. B. team.verein.de
BASE_URL=

# Cronjob: stündlich POST https://<BASE_URL>/cron mit Header X-Cron-Token (README, „Cronjob“).
# Ohne Token kommen keine Erinnerungen zum Anmeldeschluss. Erzeugen:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
CRON_TOKEN=

# ── E-Mail (Benachrichtigungen) ─────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Team Manager"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────────
# Admin abgemeldet nach Sekunden ohne Nutzung (Standard 8 Std.)
# SESSION_TIMEOUT=28800
# Koordinatoren und Mitglieder, gleitend (Standard 30 Tage)
# SESSION_MEMBER_TIMEOUT=2592000
# Sitzungsdateien: leer = Standardverzeichnis des Servers statt sessions/
# SESSION_SAVE_PATH=
# Referenz für „Update verfügbar“; leer = Prüfung aus (Standard: GitHub, main)
# UPDATE_CHECK_URL=

# ── Nur Docker ──────────────────────────────────────────────────────────────
# Diese Datei geht an die Container
APP_ENV_FILE=.env.production
APP_PORT=8080
# Superuser der mitgelieferten DB (Profil "db")
POSTGRES_DB=team_manager_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
