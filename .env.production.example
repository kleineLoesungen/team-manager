# Team Manager — Docker in Produktion. Kopieren nach .env.production (steht in .gitignore)
# und ausfüllen. Start siehe docker-compose.yml:
#   mit eigener DB:   docker compose --profile db --env-file .env.production up -d --build
#   mit externer DB:  docker compose --env-file .env.production up -d --build

# Diese Datei geht an die Container
APP_ENV_FILE=.env.production
APP_PORT=8080

# ── Datenbank ───────────────────────────────────────────────────────────────
# Eigene DB (Profil "db"):  DB_HOST=db, DB_SCHEMA=team_manager, POSTGRES_* unten setzen.
# Externe DB:               Host/Port/Name/Schema des Hosters; die DB vorher einrichten
#                           (README, "Variante: Externe Datenbank"). POSTGRES_* entfällt.
DB_HOST=db
DB_PORT=5432
DB_NAME=team_manager_db
DB_SCHEMA=team_manager
DB_USER=team_app
DB_PASS=

# Nur für die eigene DB (Superuser des Containers)
POSTGRES_DB=team_manager_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── App ─────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=            # wird beim Start gehasht; alternativ ADMIN_PASSWORD_HASH setzen
ADMIN_PASSWORD_HASH=
APP_ENV=production
BASE_URL=

# ── E-Mail (Benachrichtigungen) ────────────────────────────────────────────
MAIL_DRIVER=smtp
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Team Manager
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
